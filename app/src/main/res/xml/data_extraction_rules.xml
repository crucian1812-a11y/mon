<?xml version="1.0" encoding="utf-8"?>
<!-- Не копируем токен GitHub в облачные резервные копии и при переносе на другой телефон. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
